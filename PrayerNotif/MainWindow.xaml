<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrayerNotif.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrayerNotif"
    xmlns:formaters="using:PrayerNotif.Formatters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PrayerNotif v0.0.0.2">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <formaters:TextBoxFormatter x:Key="TextBoxFormatter"/>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
                <AppBarButton Label="Settings" Icon="Setting">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <StackPanel>
                                <CheckBox x:Name="MuteCheckBox"
                                          Content="Mute"
                                          IsChecked="False"/>
                                
                                <CheckBox x:Name="ShowOnStartupCheckBox"
                                          Content="Show Window on startup"
                                          IsEnabled="False"/>

                                <CheckBox x:Name="ManualOverrideCheckBox" 
                                          Content="Enter coordinates manually" 
                                          IsChecked="False" />
                                <CheckBox x:Name="UseAutomaticDetection" 
                                          Content="Locate coordinates automatically (also does nothing for now)" 
                                          IsEnabled="False"
                                          IsChecked="False" />

                            <Border Height="1" 
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                        Margin="0,4" />

                            <Slider x:Name="VolumeSlider" 
                                        Minimum="0" Maximum="100" 
                                        Value="100" 
                                        Width="200"
                                        Header="Volume"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                        </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>

            <AppBarButton Icon="Save" Label="Save" HorizontalAlignment="Left" Click="Save_Click"/>
            <AppBarButton Icon="Delete" Label="DEBUG delete" HorizontalAlignment="Left" Click="Delete_Click"/>

        </StackPanel>
        <AppBarButton Icon="Clock" Label="Add Coordinates" Width="120" HorizontalAlignment="Right" AllowFocusOnInteraction="True">
            <AppBarButton.Flyout>
                <Flyout>
                    <StackPanel>
                        <ListView x:Name="CordsListView" Width="300" Height="100" SelectionChanged="OnCordsSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel>
                                        <StackPanel.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Delete" Click="RemoveCoordinate_Click"/>
                                                <MenuFlyoutItem Text="Modify" Click="ModifyCoordinate_Click"/>
                                            </MenuFlyout>
                                        </StackPanel.ContextFlyout>
                                        
                                        <TextBlock Text="{x:Bind}" FontWeight="Bold" Width="300"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        
                        <Border Height="1" 
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                            Margin="0,4" />
                        <StackPanel Spacing="10">
                            <TextBox x:Name="LabelTextBox" Header="Label" PlaceholderText="e.g., Home"/>
                            <NumberBox x:Name="LatitudeSaveBox" Header="Latitude" PlaceholderText="e.g., 36.7538" 
                               NumberFormatter="{StaticResource TextBoxFormatter}"/>
                            <NumberBox x:Name="LongitudeSaveBox" Header="Longitude" PlaceholderText="e.g., 3.0588" 
                               NumberFormatter="{StaticResource TextBoxFormatter}"/>
                            <Button Content="Add Coordinates" Click="AddCoordinates_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </AppBarButton.Flyout>
        </AppBarButton>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15" Grid.Row="1">

            <TextBlock x:Name="LocationText" Text="Detecting location..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Starting up..." FontSize="14" Foreground="SlateGray" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="10">
                

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">

                    <NumberBox x:Name="LatitudeBox" 
                               Header="Latitude" 
                               PlaceholderText="e.g., 36.7538" 
                               Minimum="-90" Maximum="90" 
                               SpinButtonPlacementMode="Hidden" 
                               Width="200"
                               NumberFormatter="{StaticResource TextBoxFormatter}"
                               IsEnabled="{Binding ElementName=ManualOverrideCheckBox, Path=IsChecked}" />

                    <NumberBox x:Name="LongitudeBox" 
                               Header="Longitude" 
                               PlaceholderText="e.g., 3.0588" 
                               Minimum="-180" Maximum="180" 
                               SpinButtonPlacementMode="Hidden" 
                               Width="200"
                               NumberFormatter="{StaticResource TextBoxFormatter}"
                               IsEnabled="{Binding ElementName=ManualOverrideCheckBox, Path=IsChecked}" />
                </StackPanel>
            </StackPanel>

            <ListView x:Name="SchedulesListView" Width="500" Height="250" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ScheduleItem">
                        <StackPanel Orientation="Horizontal" Spacing="15" Padding="5" Opacity="{x:Bind DoneOpacity}">
                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" Width="80"/>
                            <TextBlock Text="{x:Bind DisplayTime}" Width="40"/>
                            <TextBlock Text="{x:Bind Note}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="RefreshButton" Content="Refresh Times" Click="Refresh_Click" HorizontalAlignment="Stretch" />
            <Button Content="Hide Window (Run in Background)" Click="HideWindow_Click" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"/>

            <TextBlock Text="app cant be closed btw. you have to close it via the task manager" 
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" Width="300" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
